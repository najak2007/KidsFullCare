rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 기본적으로 모든 접근 차단
    match /{document=**} {
      allow read, write: if false;
    }

    // ───────── 헬퍼 함수 ─────────

    // 요청자가 해당 학생 문서의 familyUids에 포함된 연결된 부모인지
    function isLinkedParent(studentUid) {
      return request.auth != null &&
             request.auth.uid in
               get(/databases/$(database)/documents/users/$(studentUid)).data.get("familyUids", []);
    }

    // 변경된 필드가 studentInfo 하나뿐인지
    function touchesStudentInfo() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["studentInfo"]);
    }

    // 클라이언트가 familyUids를 건드리는지 (연결은 Cloud Function만 처리)
    function touchesFamilyUids() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(["familyUids"]);
    }

    // ───────── users ─────────
    match /users/{userId} {

      // 1. 읽기: 본인 또는 연결된 부모
      allow read: if request.auth != null &&
                    (request.auth.uid == userId || isLinkedParent(userId));

      // 2. 생성: 본인만, familyUids는 비어 있거나 없어야 함
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && (
                      !("familyUids" in request.resource.data) ||
                      request.resource.data.familyUids.size() == 0
                    );

      // 3. 수정
      //   - 본인 문서: role은 "parent"/"student"만 허용, familyUids는 수정 불가
      //   - 연결된 부모: 자녀 문서의 studentInfo 필드만 수정 가능
      allow update: if request.auth != null
               && (
                 (
                   request.auth.uid == userId
                   && !touchesFamilyUids()
                   && (
                     !("role" in request.resource.data) ||
                     request.resource.data.role in ["parent", "student"]
                   )
                 )
                 ||
                 (
                   isLinkedParent(userId)
                   && touchesStudentInfo()
                 )
               );

      // 4. 삭제: 본인만 (회원 탈퇴용)
      allow delete: if request.auth != null && request.auth.uid == userId;

      // ───────── users/{userId}/notifications ─────────
      // 생성은 Cloud Function(Admin SDK)만 하므로 클라이언트 create는 막음
      match /notifications/{notiId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        // 읽음 처리(read 필드)만 수정 가능
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);

        allow create: if false;

        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ───────── linkCodes ─────────
    match /linkCodes/{code} {
      // 로그인한 학생 본인만 생성, studentUid가 자기 uid와 일치해야 함
      allow create: if request.auth != null
                    && request.resource.data.studentUid == request.auth.uid;

      // 로그인한 사용자면 조회 가능 (학부모가 코드로 찾아야 하므로)
      allow read: if request.auth != null;

      // studentUid/createdAt은 변경 불가
      allow update: if request.auth != null
                    && request.resource.data.studentUid == resource.data.studentUid
                    && request.resource.data.createdAt == resource.data.createdAt;

      // 삭제는 코드를 만든 학생 본인만
      allow delete: if request.auth != null
                    && resource.data.studentUid == request.auth.uid;
    }

    // ───────── profile ─────────
    match /profile/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read:   if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}