rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 기본적으로 모든 접근 차단
    match /{document=**} {
      allow read, write: if false;
    }

    // users 컬렉션 규칙
    match /users/{userId} {
      // 1. 읽기: 본인 로그인 사용자만 허용
      allow read: if request.auth != null && request.auth.uid == userId;

      // 2. 생성 (1단계: Sign in with Apple 완료 후 초기 문서 생성)
      // role 조건 검증을 제거하여 최초 가입 시 문서가 문제없이 생성되도록 합니다.
      allow create: if request.auth != null && request.auth.uid == userId;

      // 3. 수정 (2단계: role 입력 및 추후 프로필 수정)
      // 새로 추가/수정되는 role 값이 "parent" 또는 "student"인 경우 허용합니다.
      allow update: if request.auth != null 
                  && request.auth.uid == userId
                  && (
                    // role을 변경하지 않고 다른 필드만 수정하는 경우
                    !("role" in request.resource.data) || 
                    // role을 새로 설정하거나 변경할 때는 지정된 값만 허용
                    request.resource.data.role in ["parent", "student"]
                  );
    }

    match /linkCodes/{code} {
      // 코드는 로그인한 학생 본인만 생성 가능, 문서의 studentUid가 자기 uid와 일치해야 함
      allow create: if request.auth != null
                    && request.resource.data.studentUid == request.auth.uid;

      // 코드 조회는 로그인한 사용자면 누구나 가능 (학부모가 코드로 찾아야 하니까)
      allow read: if request.auth != null;

      // 사용 처리(used: true, parentUid 등 추가)는 로그인한 사용자면 가능하되
      // studentUid/createdAt은 못 바꾸게 제한
      allow update: if request.auth != null
                    && request.resource.data.studentUid == resource.data.studentUid
                    && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}